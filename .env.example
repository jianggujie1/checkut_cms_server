# 服务监听（仅本机，无鉴权）
HTTP_ADDR=127.0.0.1:8080

# 本地 CMS 主库
CMS_DB_DSN=postgres://USER:PASS@127.0.0.1:5432/checkut_cms?sslmode=disable

# Supabase（基线导入 + 发布目标），走 postgREST REST API
SUPABASE_URL=https://<ref>.supabase.co/rest/v1/
# service_role Secret key（绝不能进前端 bundle）
SUPABASE_SERVICE_KEY=sb_secret_xxxxx

# 图片上传的 Storage bucket 名（需已存在且 public）
SUPABASE_STORAGE_BUCKET=checkut

# -----------------------------------------------------------------------------
# 小红书攻略文本 AI 智能提取配置 (LLM / OpenAI 兼容 API 配置)
# -----------------------------------------------------------------------------
# 必填：大模型 API Key (支持 OpenAI, DeepSeek, Kimi, 智谱, 通义千问等)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：兼容 OpenAI 协议的 API Base 地址 (使用 DeepSeek / 国内镜像时配置，默认 https://api.openai.com/v1)
# OPENAI_API_BASE=https://api.deepseek.com/v1

# 可选：模型名称 (不填默认 gpt-4o-mini，DeepSeek 可填 deepseek-chat)
# LLM_MODEL=gpt-4o-mini
